# Copia este archivo a .env y ajusta los valores.
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Vacío = SQLite local (instance/arequipa_house.db).
# PostgreSQL: postgresql://usuario:clave@host:5432/arequipa_house
DATABASE_URL=

# Administrador inicial (se crea solo si no existe ningún administrador)
ADMIN_EMAIL=admin@arequipahouse.pe
ADMIN_PASSWORD=

# 1 = crea usuarios y publicaciones de demostración al iniciar
SEED_DEMO=1
